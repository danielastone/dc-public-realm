    {"table":"object_overviews","action":"update","id":"OBJ-0001","value":{"object_entity_id":"OBJ-0001","record_type":"person_memorial","location":"Constitution Avenue & 18th Street NW, Washington, D.C.","location_source_url":"https://www.si.edu/object/general-jose-gervasio-artigas-sculpture%3Asiris_ari_325679","event_label":"Dedicated","event_date":"June 19, 1950","event_source_url":"https://www.si.edu/object/general-jose-gervasio-artigas-sculpture%3Asiris_ari_325679","subject_name":"José Gervasio Artigas","subject_dates":"1764–1850","subject_bio":"Artigas was a military and political leader in the independence struggles of the Río de la Plata. He advocated federalism and regional autonomy and became a foundational figure in Uruguay's national history.","subject_source_url":"https://www.nps.gov/places/000/general-jose-gervasio-artigas-memorial.htm","image_url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/General_Jose_Gervasio_Artigas_Memorial_(96a9bfdb-bd4e-418b-a8a8-21f88cdd0810).jpg","image_alt":"Statue of General José Gervasio Artigas holding a hat","image_credit":"National Park Service","image_rights":"Public domain (U.S. National Park Service work)","image_source_url":"https://commons.wikimedia.org/wiki/File:General_Jose_Gervasio_Artigas_Memorial_(96a9bfdb-bd4e-418b-a8a8-21f88cdd0810).jpg","assertion_refs":{"location":"A-0008","event_date":"A-0009","subject_dates":["A-0010","A-0011"],"subject_bio":["A-0012","A-0013","A-0014"]}}},
    {"table":"object_overviews","action":"update","id":"OBJ-0002","value":{"object_entity_id":"OBJ-0002","record_type":"person_memorial","location":"Virginia Avenue between 20th & 21st Streets NW, Washington, D.C.","location_source_url":"https://www.si.edu/object/liberador-general-jose-de-san-martin-sculpture%3Asiris_ari_323790","event_label":"Dedicated","event_date":"October 28, 1925","event_source_url":"https://www.si.edu/object/liberador-general-jose-de-san-martin-sculpture%3Asiris_ari_323790","secondary_event_label":"Rededicated","secondary_event_date":"October 6, 1976","secondary_event_source_url":"https://www.si.edu/object/liberador-general-jose-de-san-martin-sculpture%3Asiris_ari_323790","subject_name":"José de San Martín","subject_dates":"1778–1850","subject_bio":"San Martín was an Argentine general and independence leader. After returning to South America from military service in Spain, he helped secure independence in Argentina, led an army across the Andes into Chile, and continued the campaign into Peru.","subject_source_url":"https://www.si.edu/object/liberador-general-jose-de-san-martin-sculpture%3Asiris_ari_323790","image_url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/General_Jose_de_San_Martin_Memorial.jpg","image_alt":"Equestrian memorial to General José de San Martín in Washington, D.C.","image_credit":"AgnosticPreachersKid / Wikimedia Commons","image_rights":"CC BY-SA 3.0","image_license_url":"https://creativecommons.org/licenses/by-sa/3.0/","image_source_url":"https://commons.wikimedia.org/wiki/File:General_Jose_de_San_Martin_Memorial.jpg","assertion_refs":{"location":"A-0110","event_date":"A-0111","secondary_event_date":"A-0112","subject_dates":["A-0113","A-0114"],"subject_bio":["A-0115","A-0116","A-0117","A-0118","A-0119"]}}},
    {"table":"object_overviews","action":"update","id":"OBJ-0003","value":{"object_entity_id":"OBJ-0003","record_type":"historical_object","location":"East Potomac Park near the 14th Street Bridge, Washington, D.C.","location_source_url":"https://www.nps.gov/places/000/cuban-american-friendship-urn.htm","event_label":"Presented to the United States","event_date":"1928","event_source_url":"https://www.nps.gov/places/000/cuban-american-friendship-urn.htm","object_context":"The urn incorporates material salvaged from the Havana memorial to the sailors who died in the 1898 explosion of USS Maine. After a 1926 hurricane damaged that memorial, Cuban officials fashioned salvaged material into the urn. Cuban President Gerardo Machado presented it to the United States during President Calvin Coolidge's 1928 visit to Cuba.","object_context_source_url":"https://www.nps.gov/places/000/cuban-american-friendship-urn.htm","image_url":"https://commons.wikimedia.org/wiki/Special:Redirect/file/CubanFriendshipUrnWashingtonDC.jpg","image_alt":"Cuban-American Friendship Urn in Washington, D.C.","image_credit":"AgnosticPreachersKid / Wikimedia Commons","image_rights":"CC BY-SA 4.0","image_license_url":"https://creativecommons.org/licenses/by-sa/4.0/","image_source_url":"https://commons.wikimedia.org/wiki/File:CubanFriendshipUrnWashingtonDC.jpg","assertion_refs":{"location":"A-0207","event_date":"A-0208","object_context":["A-0209","A-0210","A-0211","A-0212"]}}}
